# Copy to config.env and fill in. Contains no secrets.
# Authentication: run `az login` and `az devops login` (or set AZURE_DEVOPS_EXT_PAT in your
# terminal only — never in this file, never in the repository).

ORG_URL="https://dev.azure.com/<organization>"
PROJECT="<Azure DevOps project>"
REPO="<SkillMuni Frontend repository name>"

# Approvers (Azure DevOps user emails)
TECH_LEAD_EMAIL="<akash email>"          # Level 1 — Akash Murumkar
CEO_EMAIL="<rajib email>"                # Level 2 — Rajib Chowdhury
DEPUTY_CEO_EMAIL="<sonal email>"         # Level 2 deputy — Sonal Seth (backup when the CEO is away)

# Evidence vault (India region, separate from SkillMuni production)
AZ_SUBSCRIPTION="<factory subscription id or name>"
RESOURCE_GROUP="rg-tgc-factory-evidence"
LOCATION="centralindia"
EVIDENCE_ACCOUNT="tgcfactoryevidence"    # 3-24 lowercase letters/digits, globally unique
RETENTION_DAYS="2555"                    # 7 years; confirm with the Compliance Lead before locking

# Dev site for SkillMuni Frontend (setup/dev-hosting.sh)
DEV_SUBSCRIPTION="<SkillMuni non-production subscription id or name>"
DEV_RESOURCE_GROUP="rg-skillmuni-frontend-dev"
DEV_STORAGE_ACCOUNT="skmfrontenddev"     # 3-24 lowercase letters/digits, globally unique
